# =================================================================
# AMM Automation - Environment Template (.env.example)
# =================================================================

# Server & Runtime Configuration
NODE_ENV=development
PORT=3000

# Security & Session Authentication (JWT)
JWT_SECRET=amm_automation_jwt_secure_secret_key_2025_prod_ready
JWT_EXPIRES_IN=7d
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CLIENT_URL=http://localhost:3000

# Default Superadmin Credentials
ADMIN_EMAIL=admin@ammautomation.com
ADMIN_PASSWORD=Admin@12345

# Database Configuration (Optional MongoDB Atlas / Local MongoDB URI)
# If empty or unreachable, the application falls back gracefully to JSON storage
MONGODB_URI=

# AI Solution Advisor (Google Gemini API Key)
GEMINI_API_KEY=

# Email Dispatcher & SMTP Notification Settings (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AMM Automation" <no-reply@ammautomation.com>

# File & Media Upload Restrictions (5MB in bytes)
MAX_FILE_SIZE=5242880

# Client API Endpoint
VITE_API_URL=/api
